# Copy to ".env.local" for local development. On Vercel, add these under
# Project → Settings → Environment Variables instead. Leave everything empty
# to run the sample-data preview.

# Supabase → Project Settings → API (both are safe to be public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets (never prefix these with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
CRON_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
